                        </Grid>

                        </StackPanel>  <!-- fin DataContext SessionInfo -->
                        </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Calibration ════════════════════════════════════════════ -->
            <TabItem Header="Calibration" Background="#252535" Foreground="White">
                <Grid>
                    <!-- Message si pas de calibration -->
                    <TextBlock Text="No calibration associated with this session."
                               Foreground="#888" FontStyle="Italic"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSession.Calibration}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSession.Calibration}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>

                        <StackPanel Margin="12" DataContext="{Binding CurrentSession.Calibration}">

                            <!-- En-tête -->
                            <TextBlock Text="PHD2 Calibration" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                            <TextBlock Foreground="#AAAACC" FontSize="11" Margin="0,0,0,10">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}Le {0:dd/MM/yyyy à HH:mm:ss}  —  {1}">
                                        <Binding Path="StartTime"/><Binding Path="MountName"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                            <!-- ── Résultats RA / DEC ── -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A2A3A" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="RA AXIS" Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Angle" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RaAngleDeg, StringFormat={}{0:F1}°}" Foreground="#FFB74D" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RaRatePxSec, StringFormat={}{0:F3} px/s}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RaParity}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="#1A2A3A" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="DEC AXIS" Foreground="#FFB74D" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Angle" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DecAngleDeg, StringFormat={}{0:F1}°}" Foreground="#FFB74D" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DecRatePxSec, StringFormat={}{0:F3} px/s}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DecParity}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ── Graphique ── -->
                            <TextBlock Text="Calibration curve" Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,4,0,6"/>
                            <oxy:PlotView Model="{Binding DataContext.CalibrationPlot,
                                          RelativeSource={RelativeSource AncestorType=TabControl}}"
                                          x:Name="CalibrationPlotView"
                                          Background="#1E1E2E" Height="300" Margin="0,0,0,10"/>

                            <!-- ── Parameters sur 2 colonnes ── -->
                            <TextBlock Text="Parameters" Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,4,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Colonne gauche -->
                                <StackPanel Grid.Column="0" Background="#1A1A2E" >
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Cal step" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CalibrationStepMs, StringFormat={}{0} ms}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Target distance" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CalibrationDistancePx, StringFormat={}{0:F0} px}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Speed guide RA" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Foreground="White" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Text><Binding Path="RaGuideSpeedArcsecS" StringFormat='{}{0:F1}"/s'/></TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Speed guide DEC" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Foreground="White" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Text><Binding Path="DecGuideSpeedArcsecS" StringFormat='{}{0:F1}"/s'/></TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Pixel scale" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Foreground="White" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Text><Binding Path="PixelScaleArcSecPx" StringFormat='{}{0:F2}"/px'/></TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Focal length" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FocalLengthMm, StringFormat={}{0:F0} mm}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Colonne droite -->
                                <StackPanel Grid.Column="2" Background="#1A1A2E">
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="RA" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RaHours, StringFormat={}{0:F2} h}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Dec" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DecDeg, StringFormat={}{0:F1}°}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Hour angle" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HourAngle, StringFormat={}{0:F2} h}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Pier side" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PierSide}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#252540" CornerRadius="4" Padding="8,6" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Altitude" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AltDeg, StringFormat={}{0:F1}°}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#1E1E35" CornerRadius="4" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Azimuth" Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AzDeg, StringFormat={}{0:F1}°}" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>


            <!-- ── Advanced statistics ──────────────────────────── -->
            <TabItem Header="Advanced statistics" Background="#252535" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="Advanced statistical analysis" Foreground="#64B5F6" FontWeight="Bold"
                                   FontSize="14" Margin="0,0,0,14"/>
                        <Border Background="#1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Advanced statistical analysis" Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Distribution : Skewness / Kurtosis -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Error distribution" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="RA Skewness"  Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummaryRaSkewness}"  FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='⚠'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▲ strong'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▲ mod'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▼ strong'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▼ mod'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='≈'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DEC Skewness" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryDecSkewness}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryDecSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▲ strong'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▲ mod'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▼ strong'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='▼ mod'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecSkewness, Converter={StaticResource StartsWithConverter}, ConverterParameter='≈'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="RA Kurtosis"  Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SummaryRaKurtosis}"  FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryRaKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='⚠'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='△'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='✓'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='≈'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="DEC Kurtosis" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SummaryDecKurtosis}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryDecKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='⚠'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='△'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='✓'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecKurtosis, Converter={StaticResource StartsWithConverter}, ConverterParameter='≈'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Foreground="White" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="Skewness: asymmetry of error distribution (ideally close to 0)&#10;Kurtosis: frequency of large error peaks (ideally close to 0)"/>
                                    </StackPanel>

                                    <!-- Corrélation RA/DEC -->
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="RA / DEC Correlation" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pearson r" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummaryRaDecCorrelation}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryRaDecCorrelation, Converter={StaticResource StartsWithConverter}, ConverterParameter='likely flexure'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaDecCorrelation, Converter={StaticResource StartsWithConverter}, ConverterParameter='moderate correlation'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaDecCorrelation, Converter={StaticResource StartsWithConverter}, ConverterParameter='weak correlation'}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaDecCorrelation, Converter={StaticResource StartsWithConverter}, ConverterParameter='✓'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Foreground="White" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="A correlation &gt; 0.5 between RA and DEC indicates likely optical flexure or balance issue."/>
                                    </StackPanel>

                                    <!-- Test de stationnarité -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Stationarity (1st vs 2nd half)" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="RA ratio"  Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SummaryRaStability}"  FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryRaStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='strong degradation'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='degradation detected'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='↑'}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryRaStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='✓'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="DEC ratio" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SummaryDecStability}" FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SummaryDecStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='strong degradation'}" Value="True"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='degradation detected'}" Value="True"><Setter Property="Foreground" Value="#FFA726"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='↑'}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding SummaryDecStability, Converter={StaticResource StartsWithConverter}, ConverterParameter='✓'}" Value="True"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Foreground="White" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Text="2nd/1st half variance ratio. A ratio &gt; 1.5 indicates guiding degrades during the session."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Period vis sans fin ───────────────────── -->
                        <Border Background="#1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding HasWormData, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Worm period (periodic error)"
                                           Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Colonne 1 : Period mesurée -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="FFT estimate" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Period" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WormPeriodText}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#FFD54F"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Amplitude" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WormAmplitudeText}"
                                                       FontSize="11" Foreground="#FF7043"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PHD2 PEC" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WormPhd2Text}"
                                                       FontSize="11" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#AAAACC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WormConsistentPhd2}" Value="True">
                                                                <Setter Property="Foreground" Value="#81C784"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Source" Foreground="White" FontSize="10"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding WormSourceSession}"
                                                       FontSize="10" Foreground="#555577" TextWrapping="Wrap"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Colonne 2 : Confidence score -->
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Confidence score" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding WormConfidenceText}"
                                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,6">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#AAAACC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#81C784"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#FFC107"><Setter Property="Foreground" Value="#FFC107"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#FF7043"><Setter Property="Foreground" Value="#FF7043"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#EF5350"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Barre de progression -->
                                        <ProgressBar Value="{Binding WormConfidencePercent}" Minimum="0" Maximum="100"
                                                     Height="8" Margin="0,0,0,8" Width="180" HorizontalAlignment="Left"
                                                     Background="#252540" BorderThickness="0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="#AAAACC"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#81C784"><Setter Property="Foreground" Value="#81C784"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#FFC107"><Setter Property="Foreground" Value="#FFC107"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#FF7043"><Setter Property="Foreground" Value="#FF7043"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding WormConfidenceColor}" Value="#EF5350"><Setter Property="Foreground" Value="#EF5350"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding WormConfidenceDetail}"
                                                   Foreground="#AAAACC" FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Colonne 3 : Factors -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Factors" Foreground="#AAAACC" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cycles covered" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WormCyclesText}" FontSize="11" Foreground="#CE93D8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Peak SNR" Foreground="White" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding WormSnrText}" FontSize="11" Foreground="#80CBC4"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── Diagnostic dégradation ────────────────── -->
                        <Border Background="#1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding HasAltitudeData, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- En-tête avec latitude et fenêtre -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Degradation analysis — RMS vs Altitude &amp; Meridian"
                                                   Foreground="#64B5F6" FontWeight="Bold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding AltitudeLatitudeText}" Foreground="#AAAACC" FontSize="10"/>
                                            <TextBlock Text="   |   " Foreground="#444455" FontSize="10"/>
                                            <TextBlock Text="Window: " Foreground="#AAAACC" FontSize="10"/>
                                            <TextBlock Text="{Binding AltitudeWindowLabel}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#AAAACC"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AltitudeWindowFromWorm}" Value="True">
                                                                <Setter Property="Foreground" Value="#81C784"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Foreground="#FFC107" FontSize="10" VerticalAlignment="Top"
                                               Text="🔄 Meridian flip detected"
                                               Visibility="{Binding AltitudeMeridianFlip, Converter={StaticResource BoolToVis}}"/>
                                </Grid>

                                <!-- Badge diagnostic principal -->
                                <Border CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A2A1A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DegradationColor}" Value="#FF7043"><Setter Property="Background" Value="#2A1A10"/></DataTrigger>
                                                <DataTrigger Binding="{Binding DegradationColor}" Value="#FFC107"><Setter Property="Background" Value="#2A2010"/></DataTrigger>
                                                <DataTrigger Binding="{Binding DegradationColor}" Value="#64B5F6"><Setter Property="Background" Value="#101828"/></DataTrigger>
                                                <DataTrigger Binding="{Binding DegradationColor}" Value="#CE93D8"><Setter Property="Background" Value="#1E1028"/></DataTrigger>
                                                <DataTrigger Binding="{Binding DegradationColor}" Value="#AAAACC"><Setter Property="Background" Value="#252535"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DegradationIcon}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding DegradationMain}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DegradationColor}" Value="#FF7043"><Setter Property="Foreground" Value="#FFAB91"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding DegradationColor}" Value="#FFC107"><Setter Property="Foreground" Value="#FFE082"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding DegradationColor}" Value="#64B5F6"><Setter Property="Foreground" Value="#90CAF9"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding DegradationColor}" Value="#81C784"><Setter Property="Foreground" Value="#A5D6A7"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding DegradationColor}" Value="#CE93D8"><Setter Property="Foreground" Value="#CE93D8"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DegradationDetail}" Foreground="#AAAACC" FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Métriques clés -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Alt/RMS Correlation" Foreground="#AAAACC" FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DegradationPearsonText}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Trend" Foreground="#AAAACC" FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DegradationTrendText}" Foreground="#CE93D8" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                        <TextBlock Text="Mean West RMS" Foreground="#AAAACC" FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DegradationWestText}" Foreground="#64B5F6" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="0,0,8,0"
                                                Visibility="{Binding DegradationHasFlipData, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Mean East RMS" Foreground="#AAAACC" FontSize="9" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DegradationEastText}" Foreground="#FFB74D" FontSize="12" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Scatter plot RMS vs Alt -->
                                <TextBlock Text="RMS vs Altitude (⬤ Ouest, ▲ Est)" Foreground="#AAAACC" FontSize="10" Margin="0,0,0,4"/>
                                <oxy:PlotView x:Name="RmsVsAltitudePlotView"
                                              Model="{Binding RmsVsAltitudePlot}" Height="240"
                                              Background="Transparent" Foreground="White"
                                              MouseMove="PlotView_MouseMove"
                                              MouseLeave="PlotView_MouseLeave"/>
                            </StackPanel>
                        </Border>

                        <!-- ── RMS glissant + altitude — nuit complète ── -->
                        <Border Background="#1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding HasAltitudeData, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Sliding RMS and altitude — full night"
                                           Foreground="#64B5F6" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock Foreground="#AAAACC" FontSize="10" Margin="0,0,0,8"
                                           Text="{Binding AltitudeWindowLabel}"/>
                                <oxy:PlotView x:Name="SlidingRmsPlotView"
                                              Model="{Binding SlidingRmsPlot}" Height="280"
                                              Background="Transparent" Foreground="White"
                                              MouseMove="PlotView_MouseMove"
                                              MouseLeave="PlotView_MouseLeave"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
			<!-- ── Polar Alignment ──────────────────────────────────────────────────── -->
            <TabItem Header="Polar Alignment" Background="#252535" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E2E">
                    <StackPanel Margin="12,10">

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- PARAMÈTRES UTILISATEUR                                       -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#252535" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Latitude du site -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Site latitude (°N)"
                                            Foreground="#AAAACC" FontSize="10" Margin="0,0,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                Text="{Binding PolarLatitudeDeg, StringFormat=F1, UpdateSourceTrigger=LostFocus}"
                                                Background="#1E1E2E" Foreground="White"
                                                BorderBrush="#3A3A5E" Padding="6,4"
                                                FontSize="13" FontWeight="Bold"
                                                ToolTip="Your observation site latitude in degrees North"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PolarLatitudeDisplay}"
                                                Foreground="#6A9A6A" FontSize="10"
                                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Screw sensitivity (arcmin/turn) -->
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Screw sensitivity (arcmin/turn)"
                                            Foreground="#AAAACC" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding PolarArcminPerTurn, StringFormat=F0, UpdateSourceTrigger=LostFocus}"
                                            Background="#1E1E2E" Foreground="White"
                                            BorderBrush="#3A3A5E" Padding="6,4"
                                            FontSize="13" FontWeight="Bold"
                                            ToolTip="Arcminutes of correction per full screw turn (azimuth and altitude). Typically 30 arcmin/turn."/>
                                </StackPanel>

                                <!-- Bouton recalcul -->
                                <Button Grid.Column="2"
                                        Command="{Binding RefreshPolarAlignmentCommand}"
                                        Click="RefreshPolarAlignment_Click"
                                        Background="#3A7BD5" Foreground="White"
                                        Padding="14,8" BorderThickness="0"
                                        VerticalAlignment="Bottom"
                                        ToolTip="Recalculate with updated parameters">
                                    <TextBlock Text="⟳ Recalculate"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ERREUR DE CALCUL (si insuffisant)                           -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#2A1A1A" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding HasPolarError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  " Foreground="#FFC107" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PolarErrorText}"
                                        Foreground="#EF9A9A" FontSize="12"
                                        TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- RÉSULTAT PRINCIPAL                                           -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#252535" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                                Visibility="{Binding HasPolarResult, Converter={StaticResource BoolToVis}}">
                            <StackPanel>

                                <TextBlock Text="Polar alignment error"
                                        Foreground="#64B5F6" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Azimuth -->
                                    <Border Grid.Column="0" Margin="0,0,8,0"
                                            Background="#1E1E2E" CornerRadius="6" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="AZIMUTH" Foreground="#AAAACC"
                                                    FontSize="10" FontWeight="Bold"
                                                    HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding PolarErrAzText}"
                                                    Foreground="{Binding PolarErrAzColor}"
                                                    FontSize="22" FontWeight="Bold"
                                                    HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding PolarAzDirectionText}"
                                                    Foreground="#AAAACC" FontSize="11"
                                                    HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <Separator Background="#3A3A5E" Margin="0,6,0,6"/>
                                            <TextBlock Text="{Binding PolarAzTurnsText}"
                                                    Foreground="#FFD54F" FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="Azimuth screw turns to correct"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Altitude -->
                                    <Border Grid.Column="1" Margin="0,0,8,0"
                                            Background="#1E1E2E" CornerRadius="6" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="ALTITUDE" Foreground="#AAAACC"
                                                    FontSize="10" FontWeight="Bold"
                                                    HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding PolarErrAltText}"
                                                    Foreground="{Binding PolarErrAltColor}"
                                                    FontSize="22" FontWeight="Bold"
                                                    HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding PolarAltDirectionText}"
                                                    Foreground="#AAAACC" FontSize="11"
                                                    HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <Separator Background="#3A3A5E" Margin="0,6,0,6"/>
                                            <TextBlock Text="{Binding PolarAltTurnsText}"
                                                    Foreground="#FFD54F" FontSize="11"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="Altitude screw turns to correct"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Erreur totale + qualité -->
                                    <Border Grid.Column="2"
                                            Background="#1E1E2E" CornerRadius="6" Padding="12,10">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="TOTAL" Foreground="#AAAACC"
                                                    FontSize="10" FontWeight="Bold"
                                                    HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding PolarQualityIcon}"
                                                        Foreground="{Binding PolarQualityColor}"
                                                        FontSize="18" FontWeight="Bold"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding PolarTotalText}"
                                                        Foreground="{Binding PolarTotalColor}"
                                                        FontSize="22" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PolarQualityLabel}"
                                                    Foreground="{Binding PolarQualityColor}"
                                                    FontSize="12" FontWeight="Bold"
                                                    HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            <Separator Background="#3A3A5E" Margin="0,6,0,6"/>
                                            <TextBlock Text="{Binding PolarSessionsText}"
                                                    Foreground="#AAAACC" FontSize="10"
                                                    HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- QUALITY DU CALCUL (conditionnement + résidu)                -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#252535" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding HasPolarResult, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Conditionnement -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Matrix conditioning"
                                            Foreground="#AAAACC" FontSize="10" Margin="0,0,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PolarConditioningText}"
                                                Foreground="{Binding PolarConditioningColor}"
                                                FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <Border Background="#1E1E2E" CornerRadius="4" Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PolarConditioningLabel}"
                                                    Foreground="{Binding PolarConditioningColor}"
                                                    FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="#666688" Margin="0,3,0,0"
                                            Text="&lt; 50 = excellent  |  50-300 = good  |  &gt; 300 = poor"/>
                                </StackPanel>

                                <!-- RMS résidu -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Model residual RMS"
                                            Foreground="#AAAACC" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding PolarResidualText}"
                                            Foreground="#64B5F6" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="(Dec drift unexplained by the model)"
                                            Foreground="#666688" FontSize="10" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- CONSEIL DE MESURE (si conditionnement dégradé)              -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#1E2A20" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                                Visibility="{Binding HasPolarAdvice, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💡  " FontSize="14" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding PolarAdviceText}"
                                        Foreground="#A5D6A7" FontSize="11"
                                        TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- TABLEAU DES SESSIONS                                         -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#252535" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Sessions used for calculation"
                                        Foreground="#64B5F6" FontWeight="Bold"
                                        FontSize="12" Margin="0,0,0,8"/>

                                <DataGrid ItemsSource="{Binding PolarSessionRows}"
                                        AutoGenerateColumns="False"
                                        IsReadOnly="True"
                                        Background="#1E1E2E"
                                        Foreground="White"
                                        BorderThickness="0"
                                        RowBackground="#1E1E2E"
                                        AlternatingRowBackground="#222232"
                                        GridLinesVisibility="Horizontal"
                                        HorizontalGridLinesBrush="#2A2A3E"
                                        HeadersVisibility="Column"
                                        MaxHeight="260"
                                        FontSize="11">

                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background"   Value="#252535"/>
                                            <Setter Property="Foreground"   Value="#AAAACC"/>
                                            <Setter Property="FontSize"     Value="10"/>
                                            <Setter Property="FontWeight"   Value="Bold"/>
                                            <Setter Property="Padding"      Value="6,4"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush"  Value="#3A3A5E"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>

                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="6,3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                    <Setter Property="Foreground" Value="#666666"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>

                                    <DataGrid.Columns>

                                        <!-- N° Session -->
                                        <DataGridTextColumn Header="S#" Width="36"
                                            Binding="{Binding SessionIndex}"/>

                                        <!-- Time de début -->
                                        <DataGridTextColumn Header="Time" Width="68"
                                            Binding="{Binding StartTime, StringFormat=HH:mm:ss}"/>

                                        <!-- Angle Horaire (en degrés) -->
                                        <DataGridTextColumn Header="HA (°)" Width="58"
                                            Binding="{Binding HourAngle, StringFormat=+0.0;-0.0;0.0}"/>

                                        <!-- Déclinaison -->
                                        <DataGridTextColumn Header="Dec (°)" Width="62"
                                            Binding="{Binding DecDeg, StringFormat=+0.0;-0.0;0.0}"/>

                                        <!-- Altitude -->
                                        <DataGridTextColumn Header="Alt (°)" Width="56"
                                            Binding="{Binding AltDeg, StringFormat=F0}"/>

                                        <!-- Drift Dec brut -->
                                        <DataGridTextColumn Header="Mount Dec drift (&quot;/min)" Width="130"
                                            Binding="{Binding DecDriftRaw, StringFormat=+0.000;-0.000;0.000}"/>

                                        <!-- Residual -->
                                        <DataGridTextColumn Header="Residual" Width="72"
                                            Binding="{Binding Residual, StringFormat=+0.000;-0.000;—}"/>

                                        <!-- Weight -->
                                        <DataGridTextColumn Header="Weight" Width="50"
                                            Binding="{Binding Weight, StringFormat=F1}"/>

                                        <!-- Frames -->
                                        <DataGridTextColumn Header="Frames" Width="60"
                                            Binding="{Binding FrameCount}"/>

                                        <!-- Status -->
                                        <DataGridTemplateColumn Header="Status" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock VerticalAlignment="Center" Padding="6,3"
                                                            TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text"       Value="✓ Included"/>
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                                        <Setter Property="Text"
                                                                                Value="{Binding ExcludeReason}"/>
                                                                        <Setter Property="Foreground" Value="#EF9A9A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- GUIDE THÉORIQUE — POSITIONS OPTIMALES                       -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <Border Background="#1E1E2E" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Optimal positions for measurement"
                                        Foreground="#64B5F6" FontWeight="Bold"
                                        FontSize="12" Margin="0,0,0,8"/>
                                <TextBlock Foreground="#AAAACC" FontSize="10" Margin="0,0,0,6"
                                        Text="To maximise calculation reliability (minimal conditioning):"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#252535" CornerRadius="4"
                                            Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="South Meridian" Foreground="#FFD54F"
                                                    FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="HA ≈ 0h  |  Dec &lt; 30°"
                                                    Foreground="#AAAACC" FontSize="10" Margin="0,3,0,0"/>
                                            <TextBlock Text="→ Pure altitude sensitivity"
                                                    Foreground="#6A9A6A" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#252535" CornerRadius="4"
                                            Padding="10,8" Margin="0,0,6,0">
                                        <StackPanel>
                                            <TextBlock Text="East or West" Foreground="#FFD54F"
                                                    FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="HA ≈ ±3h à ±5h  |  Dec &lt; 30°"
                                                    Foreground="#AAAACC" FontSize="10" Margin="0,3,0,0"/>
                                            <TextBlock Text="→ Pure azimuth sensitivity"
                                                    Foreground="#6A9A6A" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#252535" CornerRadius="4"
                                            Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="Ideal combination" Foreground="#FFD54F"
                                                    FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="HA = −4h + HA = +2h  |  Dec variée"
                                                    Foreground="#AAAACC" FontSize="10" Margin="0,3,0,0"/>
                                            <TextBlock Text="→ Azimuth + Altitude"
                                                    Foreground="#6A9A6A" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Note déclinaison 54° -->
                                <TextBlock Foreground="#666688" FontSize="10" Margin="0,8,0,0"
                                        TextWrapping="Wrap"
                                        Text="⚠  High Dec (~54°, like M51): the altitude term becomes quasi-constant regardless of HA — azimuth/altitude separation is less precise. Combining with a session at Dec &lt; 30° greatly improves conditioning."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BARRE DE STATUT                                                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#2A2A3E" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#AAAACC" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
