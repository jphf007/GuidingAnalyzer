                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="xAngle / xRate" Foreground="#AAAACC" FontSize="11"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1}°  {1:F3} px/s">
                                            <Binding Path="MountXAngle"/><Binding Path="MountXRate"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="yAngle / yRate" Foreground="#AAAACC" FontSize="11"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="11">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1}°  {1:F3} px/s">
                                            <Binding Path="MountYAngle"/><Binding Path="MountYRate"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Parity" Foreground="#AAAACC" FontSize="11"/>
