<UserControl x:Class="GuidingAnalyzer.GuidingAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:local="clr-namespace:GuidingAnalyzer"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#1E1E2E"
             Foreground="White">

    <UserControl.Resources>
        <!-- Convertit un bool en Visible/Collapsed -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Inverse : False → Visible, True → Collapsed -->
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <!-- Retourne True si la chaîne contient le paramètre -->
        <local:StringContainsConverter x:Key="StartsWithConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BARRE D'OUTILS                                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2A2A3E" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadFileCommand}"
                        Background="#3A7BD5" Foreground="White"
                        Padding="12,6" BorderThickness="0" Margin="0,0,8,0"
                        ToolTip="Charger un fichier log PHD2">
                    <TextBlock Text="Load PHD2 log"/>
                </Button>
                <!-- Nom de fichier sans chemin -->
                <TextBlock Text="{Binding SelectedFilePath, StringFormat='  {0}'}"
                           VerticalAlignment="Center" Foreground="#AAAACC"
                           MaxWidth="280" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <Button Command="{Binding ExportCsvCommand}"
                        Background="#2E7D32" Foreground="White"
                        Padding="10,6" BorderThickness="0" Margin="0,0,4,0">
                    <TextBlock Text="Export CSV"/>
                </Button>
                <Button Command="{Binding ExportJsonCommand}"
                        Background="#1565C0" Foreground="White"
                        Padding="10,6" BorderThickness="0">
                    <TextBlock Text="Export JSON"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SÉLECTEUR DE SESSION + INFO CALIBRATION                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#1E1E35" Padding="8,5"
                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Session:" Foreground="#AAAACC" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding AvailableSessions}"
                          SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                          Background="#2A2A4E" Foreground="White"
                          BorderBrush="#3A3A5E" MinWidth="380"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="White" FontSize="11">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Session {0}  —  {1} frames  —  {2:HH:mm:ss}">
                                        <Binding Path="SessionIndex"/>
                                        <Binding Path="RawPoints.Count"/>
                                        <Binding Path="StartTime"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Calibration associée (visible seulement si présente) -->
                <Border Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="#1A3020" CornerRadius="4" Padding="8,3"
                        DataContext="{Binding SelectedSession}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Calibration}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊙ Cal. " Foreground="#81C784" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Foreground="#A5D6A7" FontSize="11">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:dd/MM HH:mm}  RA={1:F1}°  DEC={2:F1}°">
                                    <Binding Path="Calibration.StartTime"/>
                                    <Binding Path="Calibration.RaAngleDeg"/>
                                    <Binding Path="Calibration.DecAngleDeg"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Pas de calibration (visible seulement si absente) -->
                <Border Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="#2A1A1A" CornerRadius="4" Padding="8,3"
                        DataContext="{Binding SelectedSession}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Calibration}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="No preceding calibration" Foreground="#EF9A9A" FontSize="11"/>
                </Border>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BANDE DE STATISTIQUES                                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#252535" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="RMS RA" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RaRmsText}" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="RMS DEC" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DecRmsText}" Foreground="#FFB74D" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Total RMS" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRmsText}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- RA Drift -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="RA Drift" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RaDriftText}" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DEC Drift -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <TextBlock Text="DEC Drift" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DecDriftText}" Foreground="#FFB74D" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                    <TextBlock Text="Frames" Foreground="#AAAACC" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding FrameCountText}" Foreground="#CE93D8" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="6" Background="#1A237E" CornerRadius="6" Padding="12,4" Margin="8,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="QUALITY" Foreground="#AAAACC" FontSize="9" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding QualityGradeText}" Foreground="#FFEB3B"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="200"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ONGLETS PRINCIPAUX                                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="3" Background="#1E1E2E" BorderThickness="0"
                    x:Name="MainTabControl">

            <!-- ── PHD2 Curves ─────────────────────────────────────────── -->
            <TabItem Header="PHD2 Curves" Background="#252535" Foreground="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barre de contrôle : checkboxes RA / DEC -->
                    <Border Grid.Row="0" Background="#252535" Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Show: " Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox IsChecked="{Binding ShowRa}" Style="{x:Null}"
                                      Foreground="#6495ED" FontSize="11"
                                      VerticalAlignment="Center" Margin="0,0,16,0">
                                <CheckBox.Content>
                                    <TextBlock Text="RA" Foreground="#6495ED" FontWeight="Bold"/>
                                </CheckBox.Content>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShowDec}" Style="{x:Null}"
                                      Foreground="#FFA500" FontSize="11"
                                      VerticalAlignment="Center">
                                <CheckBox.Content>
                                    <TextBlock Text="DEC" Foreground="#FFA500" FontWeight="Bold"/>
                                </CheckBox.Content>
                            </CheckBox>
                            <TextBlock Text="  (Scroll = zoom  |  Left click = pan  |  Double-click = reset)"
                                       Foreground="#555577" FontSize="10" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Courbe erreurs brutes -->
                    <Grid Grid.Row="1">
                        <oxy:PlotView Model="{Binding GuidingCurvePlot}" Background="#1E1E2E" Margin="4"
                                      x:Name="GuidingPlot"
                                      MouseMove="PlotView_MouseMove"
                                      MouseLeave="PlotView_MouseLeave"/>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                                Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                Click="ResetGuidingZoom_Click">
                            <TextBlock Text="⟳ Reset"/>
                        </Button>
                    </Grid>

                    <!-- Courbe monture reconstituée -->
                    <Grid Grid.Row="2">
                        <oxy:PlotView Model="{Binding MountCurvePlot}" Background="#1E1E2E" Margin="4"
                                      x:Name="MountPlot"
                                      MouseMove="PlotView_MouseMove"
                                      MouseLeave="PlotView_MouseLeave"/>
                        <!-- Boutons superposés en haut à droite -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0">
                            <ToggleButton IsChecked="{Binding ShowDriftCorrected}"
                                          Padding="6,2" FontSize="10" Cursor="Hand"
                                          BorderThickness="1" Margin="0,0,6,0"
                                          OverridesDefaultStyle="True">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Background"   Value="#333355"/>
                                        <Setter Property="Foreground"   Value="#AAAACC"/>
                                        <Setter Property="BorderBrush"  Value="#555577"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}"
                                                            CornerRadius="2">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background"   Value="#1A5C3A"/>
                                                <Setter Property="Foreground"   Value="#81C784"/>
                                                <Setter Property="BorderBrush"  Value="#81C784"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                                <TextBlock Text="⇥ Drift Correction" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                            </ToggleButton>
                            <Button Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                    BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                    Click="ResetMountZoom_Click">
                                <TextBlock Text="⟳ Reset"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── FFT Analysis ──────────────────────────────────────────── -->
            <TabItem Header="FFT Analysis" Background="#252535" Foreground="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- sélecteur mode -->
                        <RowDefinition Height="*"/>     <!-- RA -->
                        <RowDefinition Height="*"/>     <!-- DEC -->
                    </Grid.RowDefinitions>

                    <!-- ── Barre de sélection mode ── -->
                    <Border Grid.Row="0" Background="#252540" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Mode: " Foreground="#AAAACC" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="Drift-corrected (with PHD2 corrections)"
                                         IsChecked="{Binding FftShowCorrected, Mode=TwoWay}"
                                         Foreground="#64B5F6" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"
                                         GroupName="FftMode"/>
                            <RadioButton Content="RA Corrections Removed (raw mount)"
                                         IsChecked="{Binding FftShowUncorrected, Mode=TwoWay}"
                                         Foreground="#FFB74D" FontSize="11" VerticalAlignment="Center"
                                         GroupName="FftMode"/>
                            <TextBlock Text="  |  Scroll = zoom X  |  Double-click = reset  |  Y zoom disabled"
                                       Foreground="#444466" FontSize="10" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ── RA ── -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Drift-corrected -->
                        <Grid Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}">
                            <oxy:PlotView Model="{Binding FftRaPlot}" Background="#1E1E2E" Margin="4"
                                          x:Name="FftRaPlotView"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                                    Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                    BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                    Click="ResetFftRaZoom_Click"><TextBlock Text="⟳ Reset"/></Button>
                        </Grid>
                        <!-- Corrections Removed -->
                        <Grid Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}">
                            <oxy:PlotView Model="{Binding FftRaUncorrectedPlot}" Background="#1E1E2E" Margin="4"
                                          x:Name="FftRaUncorrPlotView"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                                    Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                    BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                    Click="ResetFftRaUncorrZoom_Click"><TextBlock Text="⟳ Reset"/></Button>
                        </Grid>

                        <!-- Tableau des pics RA -->
                        <Expander Grid.Row="1" Background="#1E1E30" Foreground="White" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Detected RA peaks — " FontSize="11" Foreground="#AAAACC"/>
                                    <TextBlock Text="Drift-corrected" FontSize="11" Foreground="#64B5F6"
                                               Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Corrections Removed" FontSize="11" Foreground="#FFB74D"
                                               Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <!-- En-tête tableau -->
                                <Grid Margin="8,4,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Period" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Amplitude" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="Confidence" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="Interprétation" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                </Grid>
                                <!-- Pics Drift-corrected -->
                                <ItemsControl Margin="8,0"
                                    ItemsSource="{Binding CurrentSession.FftRa.SignificantPeaks}"
                                    Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PeriodSeconds, StringFormat='{}{0:F0} s'}" Foreground="#64B5F6" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmplitudeArcsec, StringFormat='{}{0:F3}&quot;'}" Foreground="#FFEB3B" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="#80CBC4" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Interpretation}" Foreground="#AAAACC" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Pics Corrections Removed -->
                                <ItemsControl Margin="8,0"
                                    ItemsSource="{Binding CurrentSession.FftRaUncorrected.SignificantPeaks}"
                                    Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PeriodSeconds, StringFormat='{}{0:F0} s'}" Foreground="#FFB74D" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmplitudeArcsec, StringFormat='{}{0:F3}&quot;'}" Foreground="#FFEB3B" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="#80CBC4" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Interpretation}" Foreground="#AAAACC" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Grid>

                    <!-- ── DEC ── -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Drift-corrected -->
                        <Grid Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}">
                            <oxy:PlotView Model="{Binding FftDecPlot}" Background="#1E1E2E" Margin="4"
                                          x:Name="FftDecPlotView"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                                    Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                    BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                    Click="ResetFftDecZoom_Click"><TextBlock Text="⟳ Reset"/></Button>
                        </Grid>
                        <!-- Corrections Removed -->
                        <Grid Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}">
                            <oxy:PlotView Model="{Binding FftDecUncorrectedPlot}" Background="#1E1E2E" Margin="4"
                                          x:Name="FftDecUncorrPlotView"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,14,0"
                                    Padding="6,2" FontSize="10" Background="#333355" Foreground="#AAAACC"
                                    BorderThickness="1" BorderBrush="#555577" Cursor="Hand"
                                    Click="ResetFftDecUncorrZoom_Click"><TextBlock Text="⟳ Reset"/></Button>
                        </Grid>

                        <!-- Tableau des pics DEC -->
                        <Expander Grid.Row="1" Background="#1E1E30" Foreground="White" IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Detected DEC peaks — " FontSize="11" Foreground="#AAAACC"/>
                                    <TextBlock Text="Drift-corrected" FontSize="11" Foreground="#64B5F6"
                                               Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="Corrections Removed" FontSize="11" Foreground="#FFB74D"
                                               Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel>
                                <Grid Margin="8,4,8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Period" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="Amplitude" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="2" Text="Confidence" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="3" Text="Interprétation" Foreground="#666688" FontSize="10" FontWeight="Bold"/>
                                </Grid>
                                <ItemsControl Margin="8,0"
                                    ItemsSource="{Binding CurrentSession.FftDec.SignificantPeaks}"
                                    Visibility="{Binding FftShowCorrected, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PeriodSeconds, StringFormat='{}{0:F0} s'}" Foreground="#FFB74D" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmplitudeArcsec, StringFormat='{}{0:F3}&quot;'}" Foreground="#FFEB3B" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="#80CBC4" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Interpretation}" Foreground="#AAAACC" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Margin="8,0"
                                    ItemsSource="{Binding CurrentSession.FftDecUncorrected.SignificantPeaks}"
                                    Visibility="{Binding FftShowUncorrected, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding PeriodSeconds, StringFormat='{}{0:F0} s'}" Foreground="#FFB74D" FontWeight="Bold" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AmplitudeArcsec, StringFormat='{}{0:F3}&quot;'}" Foreground="#FFEB3B" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat='{}{0:P0}'}" Foreground="#80CBC4" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Interpretation}" Foreground="#AAAACC" FontSize="10" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ── Advice ──────────────────────────────────────────────── -->
            <TabItem Header="Advice" Background="#252535" Foreground="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ItemsControl ItemsSource="{Binding Advice}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="12,10" CornerRadius="6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"  Value="#1A1A2E"/>
                                                <Setter Property="BorderBrush" Value="#555577"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                        <Setter Property="Background"  Value="#3A0808"/>
                                                        <Setter Property="BorderBrush" Value="#F44336"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
